{
  "name": "hono-starter",
  "type": "module",
  "version": "1.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "npm run lint --fix",
    "test": "cross-env NODE_ENV=test vitest",
    "build": "tsc && tsc-alias",
    "db:generate": "bunx prisma generate",
    "postinstall": "bunx prisma generate",
    "db:migrate:dev": "bunx prisma migrate dev",
    "db:migrate:deploy": "bunx prisma migrate deploy",
    "db:push": "bunx prisma db push",
    "db:studio": "bunx prisma studio"
  },
  "dependencies": {
    "@hono/node-server": "^1.18.1",
    "@hono/zod-openapi": "^1.0.2",
    "@logtail/node": "^0.5.8",
    "@logtail/pino": "^0.5.8",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@scalar/hono-api-reference": "^0.9.13",
    "dotenv": "^17.4.2",
    "dotenv-expand": "^12.0.2",
    "hono": "^4.9.6",
    "hono-pino": "^0.10.1",
    "hono-rate-limiter": "^0.5.3",
    "i18n-iso-countries": "^7.14.0",
    "lru-cache": "^11.5.1",
    "otplib": "^13.4.1",
    "pg": "^8.22.0",
    "pino": "^9.7.0",
    "pino-pretty": "^13.1.1",
    "qrcode": "^1.5.4",
    "stoker": "2.0.1",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^5.1.0",
    "@types/node": "^24.2.0",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "cross-env": "^10.0.0",
    "eslint": "^9.32.0",
    "eslint-plugin-format": "^1.0.1",
    "prisma": "^7.8.0",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.1"
  }
}
